# Where Pinch keeps its SQLite database (one file). Back it up nightly.
PINCH_DB_PATH=./data/pinch.db

# Each brand's folder on the Mac mini. The importer only reads from these,
# and media is only ever served from inside the brand's own folder.
PINCH_ANDAR_ROOT="/Users/production/Library/CloudStorage/Dropbox-Paprika/Nath Anthony Ybañez/Andar"
PINCH_NEST_ROOT="/Users/production/Library/CloudStorage/Dropbox-Paprika/Nath Anthony Ybañez/Nest Workspaces"

# Approver sign-in. With no passcode set, anyone who can reach the app can
# approve (fine on a laptop, never on the Mac mini). SECRET signs the cookie:
# generate one with `openssl rand -hex 32`.
PINCH_PASSCODE=
PINCH_SECRET=
PINCH_APPROVER_NAME=nath

# Token makers (people or agents) use for POST /api/posts. Leave empty to
# turn the maker API off. Generate with `openssl rand -hex 32`.
PINCH_MAKER_TOKEN=
